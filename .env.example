# ===========================================================================
# Android VPS Platform — environment configuration
# Copy this file to `.env` on the VPS and fill in real values.
# NEVER commit the real `.env` file. `docker-compose.yml` reads `.env`.
# ===========================================================================

# --- Server ---
# Port the API listens on (inside Docker it is 3000; published port is set in docker-compose.yml)
PORT=3000
# Public base URL of the platform (used for display links + noVNC route)
PUBLIC_URL=http://localhost:3000
# Node log level: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---
# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string
# Token lifetime
JWT_EXPIRES_IN=8h

# First admin account created automatically on first run (only if no users exist).
# The plain password below is used ONLY at bootstrap time and never logged.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Database ---
# SQLite file path (relative to apps/api or absolute). Volume-mounted in Docker.
DB_PATH=./data/android-vps.db

# --- Runtime (Android driver) ---
# auto  -> detect the best available driver at boot
# docker -> redroid (containerized Android) — recommended when binder modules exist
# qemu  -> Android-x86 under QEMU (KVM if available, otherwise slow TCG mode)
# fake  -> in-memory simulator — DO NOT USE IN PRODUCTION, for tests/demo only
RUNTIME_DRIVER=auto

# --- redroid (Docker driver) ---
# Docker image tag for Android containers
REDROID_IMAGE=redroid/redroid:14.0.0-latest
# Android version label shown in the dashboard for redroid instances
REDROID_ANDROID_VERSION=Android 14
# VNC server APK used to expose the redroid screen (see runtime/scripts/install-droidvnc.sh)
DROIDVNC_APK_URL=https://github.com/billchen198318/droidVNC-NG/releases/download/latest/droidVNC-NG_1.3.15.apk

# --- QEMU driver (fallback) ---
# Path to the Android-x86 / Bliss OS disk image (see runtime/scripts/fetch-android-image.sh)
QEMU_ANDROID_IMAGE=/opt/android-vps/images/android-x86_64.img
# QEMU binary
QEMU_BIN=qemu-system-x86_64
# Android version label for QEMU instances
QEMU_ANDROID_VERSION=Android 9 (x86_64)

# --- Port ranges (per-instance allocation) ---
# VNC display ports (RFA / noVNC)
VNC_PORT_START=5900
VNC_PORT_END=5999
# ADB TCP ports
ADB_PORT_START=5555
ADB_PORT_END=5564

# --- Resource defaults & limits ---
# Default per-instance allocation when the API request does not specify values
DEFAULT_CPU_LIMIT=2
DEFAULT_MEMORY_LIMIT_MB=4096
DEFAULT_STORAGE_LIMIT_GB=20
# Hard ceiling per single instance (prevents a bad request from exhausting the host)
MAX_CPU_PER_INSTANCE=8
MAX_MEMORY_PER_INSTANCE_MB=8192
# Minimum free host resources required before creating an instance
MIN_FREE_MEMORY_MB=2048
MIN_FREE_DISK_GB=5

# --- Security ---
# Max failed login attempts before temporary lockout
LOGIN_MAX_ATTEMPTS=5
# Lockout window in seconds
LOGIN_LOCKOUT_SECONDS=300
# API rate limit window (seconds)
RATE_LIMIT_WINDOW_SECONDS=60
# Max requests per window (per IP)
RATE_LIMIT_MAX=300

# --- Monitoring ---
# Health check interval (seconds) used by automated monitors
HEALTH_INTERVAL_SECONDS=30